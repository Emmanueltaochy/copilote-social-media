# Ce fichier est un modèle. Sur le VPS, le vrai .env est écrit automatiquement
# par scripts/setup-vps.sh — normalement tu n'as rien à toucher ici.

# Port local sur lequel l'app écoute. Le script choisit le premier libre à
# partir de 3001 pour ne pas entrer en conflit avec les autres SaaS du VPS.
APP_PORT=3001

# Image à déployer. Le workflow publie :latest et :<sha> ; épingler un sha
# permet de revenir à une version précédente sans reconstruire.
APP_IMAGE=ghcr.io/emmanueltaochy/copilote-social-media:latest

# Affiché par /api/health : permet de vérifier quelle version tourne.
APP_VERSION=dev

# Domaine servi par nginx. Pour en changer, relancer le script avec --domain.
APP_DOMAIN=marketing.taochyconsulting.fr
