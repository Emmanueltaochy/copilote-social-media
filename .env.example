# Modèle. Sur le VPS, le vrai .env est écrit par scripts/setup-vps.sh.

APP_PORT=3001
APP_IMAGE=ghcr.io/emmanueltaochy/copilote-social-media:latest
APP_VERSION=dev
APP_DOMAIN=marketing.taochyconsulting.fr

# Mot de passe de la base, généré à l'installation.
# Ne jamais le modifier après coup : les données deviendraient illisibles.
DB_PASSWORD=change-moi

