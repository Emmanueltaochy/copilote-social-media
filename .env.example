# Copier en .env sur le VPS : cp .env.example .env
# Ce fichier-ci est versionné, .env ne l'est pas.

# Port local sur lequel l'app écoute. 3001 par défaut pour ne pas entrer en
# conflit avec les autres SaaS du VPS. Vérifier qu'il est libre :
#   ss -tlnp | grep 3001
APP_PORT=3001

# Image à déployer. Le workflow pousse :latest et :<sha> ; épingler un sha
# permet de revenir en arrière sans rebuild.
APP_IMAGE=ghcr.io/emmanueltaochy/copilote-social-media:latest

# Affiché par /api/health, pratique pour vérifier quelle version tourne.
APP_VERSION=dev
